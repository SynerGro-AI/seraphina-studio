//! Extended per-element properties (embedded; never fetched at runtime).
//!
//! Sources and licences (downloaded 2026-10-20):
//! * pymatgen `periodic_table.json` (pymatgen-core 2026.10.16, MIT licence,
//!   data largely from WebElements/CRC): electrical resistivity (Ω·m),
//!   Young's / bulk / shear modulus (GPa), Poisson ratio, Mohs hardness,
//!   linear thermal expansion (1/K), speed of sound (m/s), ionization
//!   energies (eV).
//! * mendeleev database (MIT licence; per-property sources are cited in the
//!   package): electron configuration (shells derived from it), Pyykkö
//!   covalent radius (pm), specific heat (J/(g·K)), molar heat capacity
//!   (J/(mol·K)), thermal conductivity (W/(m·K)), crystal lattice, heat of
//!   fusion / vaporization (kJ/mol), discovery year and discoverers,
//!   radioactivity, isotopes (stable isotopes with natural abundance;
//!   longest-lived isotope and its half-life, NUBASE via mendeleev).
//! * Appearance text: Bowserinator Periodic-Table-JSON (CC BY-SA 3.0, text
//!   from Wikipedia), https://github.com/Bowserinator/Periodic-Table-JSON .
//!
//! `None` / empty means the source has no value; the UI shows "unknown".
//! Nothing is invented or interpolated.
//!
//! Generated by tools/gen_element_props.py; do not edit by hand.

#[derive(Clone, Copy, Debug, PartialEq)]
pub struct ElementProps {
    pub z: u32,
    /// Electrons per shell, K first.
    pub shells: &'static [u8],
    pub config_full: &'static str,
    /// Successive ionization energies (eV), up to 10.
    pub ionization_ev: &'static [f32],
    pub covalent_radius_pm: Option<f32>,
    /// J/(g·K)
    pub specific_heat: Option<f32>,
    /// J/(mol·K)
    pub molar_heat: Option<f32>,
    /// W/(m·K)
    pub thermal_conductivity: Option<f32>,
    /// Ω·m (room temperature)
    pub electrical_resistivity: Option<f64>,
    pub crystal: &'static str,
    pub youngs_gpa: Option<f32>,
    pub bulk_gpa: Option<f32>,
    pub shear_gpa: Option<f32>,
    pub poisson: Option<f32>,
    pub mohs: Option<f32>,
    /// 1/K
    pub thermal_expansion: Option<f32>,
    /// m/s
    pub sound_speed: Option<f32>,
    pub fusion_heat_kj_mol: Option<f32>,
    pub vaporization_heat_kj_mol: Option<f32>,
    pub appearance: &'static str,
    pub discovery_year: Option<u16>,
    pub discoverers: &'static str,
    pub radioactive: bool,
    pub stable_isotopes: &'static str,
    /// Half-life (s) of the longest-lived isotope, for radioactive elements.
    pub longest_half_life_s: Option<f64>,
    pub longest_lived_isotope: Option<u32>,
}

impl ElementProps {
    /// Electrical conductivity (S/m) from resistivity.
    pub fn electrical_conductivity(&self) -> Option<f64> {
        self.electrical_resistivity.filter(|r| *r > 0.0).map(|r| 1.0 / r)
    }
}

pub fn props(z: u32) -> Option<&'static ElementProps> {
    z.checked_sub(1).and_then(|i| PROPS.get(i as usize)).filter(|p| p.z == z)
}

static PROPS: &[ElementProps] = &[
@@ROWS@@
];

#[cfg(test)]
mod tests {
    use super::*;
    use crate::element_data::by_symbol;

    fn p(s: &str) -> &'static ElementProps {
        props(by_symbol(s).unwrap().z).unwrap()
    }
    fn close(a: Option<f32>, b: f32, rel: f32) -> bool {
        a.map(|a| ((a - b) / b).abs() <= rel).unwrap_or(false)
    }

    #[test]
    fn every_element_present_and_shells_sum_to_z() {
        for z in 1..=118u32 {
            let e = props(z).unwrap();
            assert_eq!(e.shells.iter().map(|&s| s as u32).sum::<u32>(), z);
        }
        assert_eq!(p("Na").shells, &[2, 8, 1]);
        assert_eq!(p("Au").shells, &[2, 8, 18, 32, 18, 1]);
    }

    #[test]
    fn spot_check_known_values() {
        // CRC Handbook room-temperature values
        assert!(p("Cu").electrical_resistivity.map(|r| (r - 1.68e-8).abs() < 0.05e-8).unwrap());
        assert!(close(p("Cu").thermal_conductivity, 401.0, 0.02));
        assert!(close(p("Al").specific_heat, 0.897, 0.02));
        assert!(close(p("Fe").youngs_gpa, 211.0, 0.03));
        assert!(close(p("Cu").poisson, 0.34, 0.03));
        assert!(close(p("H").ionization_ev.first().copied(), 13.598, 0.001));
        assert!(close(p("Fe").fusion_heat_kj_mol, 13.8, 0.03));
        assert_eq!(p("Fe").crystal, "Body-centred cubic");
        assert_eq!(p("Cu").crystal, "Face-centred cubic");
        assert!(p("Cu").stable_isotopes.contains("63Cu"));
        assert!(!p("Cu").radioactive && p("Cu").longest_half_life_s.is_none());
        // Tc has no stable isotope: 97Tc, about 4.2 million years
        assert!(p("Tc").radioactive);
        let tc = p("Tc").longest_half_life_s.unwrap() / (365.25 * 86400.0);
        assert!(tc > 4.0e6 && tc < 4.4e6, "{}", tc);
        // U-238: 4.468e9 years
        let u = p("U").longest_half_life_s.unwrap() / (365.25 * 86400.0);
        assert!((u - 4.468e9).abs() / 4.468e9 < 0.01, "{}", u);
        assert!(p("Au").appearance.contains("yellow"));
    }
}
